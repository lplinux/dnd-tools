# ─── D&D Tools — Environment Configuration ───────────────────
# Copy this file to .env and fill in your values.
#   cp .env.example .env

# ── Database ──────────────────────────────────────────────────
# app.js builds its connection pool from these five variables ONLY.
# NOTE: DATABASE_URL is NOT read by app.js. The setup scripts accept it, so
# setting it alone will point the scripts and the server at different databases.
#
# These are the HOST-side settings, used by `node app.js` run directly and by
# scripts/setup-db.js. They are NOT what the container uses: docker-compose.yml
# hardcodes DB_HOST=postgres / DB_PORT=5432 for the app container, which is
# correct inside the compose network.
#
# 15432, not 5432: docker-compose publishes postgres on "15432:5432" so it does
# not collide with a postgres you may already run locally. Pointing this at 5432
# either fails with ECONNREFUSED, or — worse, if you DO have a local postgres —
# quietly succeeds against the wrong server, which surfaces much later as
# "users table not found".
#
# DB_PASSWORD: run.sh REPLACES this with a random value when it creates your .env
# on a fresh install, and docker-compose.yml interpolates ${DB_PASSWORD} into both
# the app service and POSTGRES_PASSWORD, so the two cannot drift. Changing it
# later does NOT re-key an existing database: postgres honours POSTGRES_PASSWORD
# only when initdb runs on an empty data directory, and the pg_isready healthcheck
# does not authenticate, so the container still reports healthy while every
# connection fails. To rotate: `docker compose down -v` (destroys data), or
# ALTER ROLE by hand and then edit this file.
DB_HOST=localhost
DB_PORT=15432
DB_USER=dndtools
DB_PASSWORD=dndtools123
DB_NAME=dndtools

# ── App ───────────────────────────────────────────────────────
# run.sh REPLACES both of the placeholders below with real random values when it
# creates your .env, so a normal bootstrap never ships these. They are only
# reached if you copy this file by hand — in which case change them. Both are
# published in this repository, so leaving them means anyone can forge a session
# cookie or a share-link token.

# Signs session cookies.
SESSION_SECRET=change-me-to-something-long-and-random

# HMAC secret behind every public share link (/pc-public/:token and friends).
ID_SECRET=change-me-too-to-something-long-and-random

# HTTP port the Node.js server listens on (default: 3080).
# Safe to change: docker-compose.yml reads this same variable for BOTH the publish
# mapping and the container's PORT, and run.sh uses it for the port preflight, the
# readiness poll and the banner. It used to be a trap — compose hardcoded 3080:3080,
# so setting this made the app listen somewhere the publish never pointed at.
# PORT=3080
